{
  "manifest_version": 3,
  "name": "Bitrix to WhatsApp AutoSender",
  "version": "1.1",
  "description": "Автоматизация отправки прайсов и смены статусов в Битрикс24 через WhatsApp Web",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.bitrix24.ru/*",
    "*://*.bitrix24.kz/*",
    "*://*.bitrix24.com/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bitrix24.ru/*", "*://*.bitrix24.kz/*", "*://*.bitrix24.com/*", "https://whatsapp.com*"],
      "js": ["bridge.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bitrix WA Bot"
  },
  "background": {
    "scripts": ["content/background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["price.pdf"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}